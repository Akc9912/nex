{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/claude-sonnet-5-5",
  "default_agent": "build",

  // Global safety rules. Agent-specific rules are generated from shared/agents.
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "pacman *", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "read", "resource": "**/.env", "effect": "ask" },
    { "action": "read", "resource": "**/.env.*", "effect": "ask" },
    { "action": "read", "resource": "**/*.pem", "effect": "ask" },
    { "action": "read", "resource": "**/*.key", "effect": "ask" }
  ],

  "compaction": {
    "auto": true,
    "keep": { "tokens": 12000 },
    "buffer": "15%"
  },

  "experimental": {
    "todo": true,
    "subagent_depth": 1,
    "background_compaction": true
  },

  "formatter": true,

  // MCP: keep the default set small. Disabled servers remain configured but do
  // not connect or consume context. Enable with "disabled": false (or via /mcps).
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "engram": {
        "type": "local",
        "command": ["/bin/sh", "-c", "exec \"$HOME/.local/bin/engram\" mcp --tools=agent"],
        "codemode": false
      },
      "codegraph": {
        "type": "local",
        "command": ["/bin/sh", "-c", "exec \"$HOME/.local/bin/codegraph\" serve --mcp"],
        "codemode": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": ["playwright-mcp"],
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["chrome-devtools-mcp"],
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "disabled": true
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp",
        "disabled": true
      }
    }
  }
}
